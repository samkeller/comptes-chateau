{
  "eslint.run": "onSave",
  "editor.codeActionsOnSave": {
    "source.fixAll.ts": "always",
    "source.fixAll.eslint": "always"
  },
  "eslint.workingDirectories": [
    {
      "directory": "react",
      "changeProcessCWD": true
    },
    {
      "directory": "node",
      "changeProcessCWD": true
    }
  ],
  "eslint.validate": [
    "javascript",
    "typescript"
  ],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.vite/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  },
  "chat.tools.terminal.autoApprove": {
    // Tests
    "/^npm run tests(:front|:back)?$/": true,
    // Builds
    "/^npm run build(:shared|:react|:node)?$/": true,
    //Lint / Typecheck
    "/^npm run (lint|typecheck)$/": true,
    // Git : commandes de lecture
    "/^git status(\\s|$)/": true,
    "/^git diff(\\s|$)/": true,
    "/^git log(\\s|$)/": true,
    "/^git show(\\s|$)/": true,
    // PowerShell : lecture et diagnostic
    "Get-Location": true,
    "Get-ChildItem": true,
    "Get-Content": true,
    "Get-Item": true,
    "Test-Path": true,
    "Resolve-Path": true,
    "Select-String": true,
    "Get-Process": true,
    "Get-NetTCPConnection": true,
    "Get-Service": true,
    "Get-Command": true,
    "Get-Help": true
  }
}