{
  "name": "comptes-chateau",
  "private": true,
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n SHARED,FRONT,BACK -c \"yellow,blue,magenta\" --prefix \"[{time}] {name}\" --timestamp-format \"HH:mm:ss.SSS\" --kill-others \"npm:shared:watch\" \"npm:dev:frontend\" \"npm:dev:node\"",
    "shared:watch": "npm --workspace @chocosous/shared run watch",
    "dev:frontend": "wait-on http://localhost:8000/health && npm run dev:react",
    "dev:react": "npm --prefix react start",
    "dev:node": "npm --prefix node run dev",
    "build": "npm run build:shared && npm run build:react && npm run build:node",
    "build:shared": "npm --workspace @chocosous/shared run build",
    "build:react": "npm --prefix react run build",
    "build:node": "npm --prefix node run build",
    "tests:front": "npm --prefix react run tests",
    "tests:back": "npm --prefix node run tests",
    "tests": "npm run tests:front && npm run tests:back"
  },
  "workspaces": [
    "node",
    "react",
    "shared"
  ],
  "packageManager": "npm@11.11.0",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.1.0"
  }
}