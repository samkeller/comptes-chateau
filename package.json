{
  "name": "comptes-chateau",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install && cd react && npm install && cd ../node && npm install",
    "dev": "concurrently -n FRONT,BACK -c \"blue,magenta\" --prefix \"[{time}] {name}\" --timestamp-format \"HH:mm:ss.SSS\" --kill-others \"npm:dev:frontend\" \"npm:dev:node\"",
    "dev:frontend": "wait-on http://localhost:8000/health && npm run dev:react",
    "dev:react": "npm --prefix react start",
    "dev:node": "npm --prefix node run dev",
    "build": "npm run build:react && npm run build:node",
    "build:react": "npm --prefix react run build",
    "build:node": "npm --prefix node run build",
    "tests": "npm run tests:front && npm run tests:back",
    "tests:front": "npm --prefix react run tests",
    "tests:back": "npm --prefix node run tests"
  },
  "packageManager": "npm@11.11.0",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.1.0"
  }
}